// obs-scene-relight Lens Blur: 背景ぼかし（レンズのぼけ・玉ボケ）
// tools/reference.py の lens_blur() と同じ式
//
// 流れ: 入力（sRGB）-> 線形光に直して 1/2 ずつ縮める（半径が大きいとき）-> 円盤状にぼかす -> 3 次 B スプラインで拡大して sRGB に戻す
// パラメータは technique を 1 つ描くたびに空に戻る（OBS の仕様）。パスの直前に設定すること
// SPDX-License-Identifier: GPL-2.0-or-later

#include "common.effect"

uniform texture2d image;
uniform float2 texel;  // 出力の 1 テクセル（uv 単位）
uniform float radius;  // ぼかしの半径（この段の画素単位）
uniform float bokeh;   // 明るい点を強調する量（玉ボケ）
uniform float ramp;    // 奥行きの傾斜（0 = 一様）
uniform float cubic;   // 拡大に双三次を使う（1）か双一次（0）か。縮めたときは 1

// premultiplied sRGB -> premultiplied 線形
float4 hz_to_lin(float4 s)
{
	float4 u = hz_unpremul(s);
	return float4(hz_srgb_to_lin(u.rgb) * s.a, s.a);
}

// 1:1 で線形に直す（縮めないとき）
float4 PSLin(VertData v) : TARGET
{
	return hz_to_lin(image.SampleLevel(pointClamp, v.uv, 0.0));
}

// 線形に直しながら 1/2 に縮める（2x2 点）
float4 PSDownLin(VertData v) : TARGET
{
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	for (int j = 0; j < 2; j++) {
		for (int i = 0; i < 2; i++) {
			float2 uv = v.uv + (float2(float(i), float(j)) + 0.5 - 1.0) / 2.0 * texel;
			acc += hz_to_lin(image.SampleLevel(linearClamp, uv, 0.0));
		}
	}
	return acc / 4.0;
}

// 線形のまま 1/2 に縮める（2x2 点）
float4 PSDown2(VertData v) : TARGET
{
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	for (int j = 0; j < 2; j++) {
		for (int i = 0; i < 2; i++) {
			float2 uv = v.uv + (float2(float(i), float(j)) + 0.5 - 1.0) / 2.0 * texel;
			acc += image.SampleLevel(linearClamp, uv, 0.0);
		}
	}
	return acc / 4.0;
}

// 円盤状のぼかし。64 点（黄金角のらせん）。明るい点ほど重く数えて、玉ボケにする
float4 PSDisc(VertData v) : TARGET
{
	float rs = radius * lerp(1.0, 0.25 + 1.25 * (1.0 - v.uv.y), ramp);
	float4 acc = float4(0.0, 0.0, 0.0, 0.0);
	float ws = 0.0;
	for (int i = 0; i < 64; i++) {
		float rr = sqrt((float(i) + 0.5) / 64.0) * rs;
		float th = float(i) * 2.39996323;
		float4 s = image.SampleLevel(linearClamp, v.uv + float2(cos(th), sin(th)) * rr * texel, 0.0);
		float t = saturate((hz_luma(s.rgb) - 0.4) / 0.6);
		float w = 1.0 + bokeh * 12.0 * t * t;
		acc += s * w;
		ws += w;
	}
	return acc / ws;
}

// 3 次 B スプラインで拡大する（双一次補間 4 回で済ませる方法）。texel = 入力（ぼかした画像）の 1 テクセル。
// 低い解像度から大きく拡大したときの、玉ボケの縁のブロック状のギザギザを滑らかにする
float4 hz_bspline(float2 uv)
{
	float2 size = float2(1.0, 1.0) / texel;
	float2 pos = uv * size - 0.5;
	float2 i = floor(pos);
	float2 f = pos - i;
	float2 f2 = f * f;
	float2 f3 = f2 * f;
	float2 w0 = (1.0 - f) * (1.0 - f) * (1.0 - f) / 6.0;
	float2 w1 = (3.0 * f3 - 6.0 * f2 + 4.0) / 6.0;
	float2 w2 = (-3.0 * f3 + 3.0 * f2 + 3.0 * f + 1.0) / 6.0;
	float2 w3 = f3 / 6.0;
	float2 g0 = w0 + w1;
	float2 g1 = w2 + w3;
	float2 p0 = (i - 1.0 + w1 / g0 + 0.5) * texel;
	float2 p1 = (i + 1.0 + w3 / g1 + 0.5) * texel;
	return g0.y * (g0.x * image.SampleLevel(linearClamp, float2(p0.x, p0.y), 0.0) +
		       g1.x * image.SampleLevel(linearClamp, float2(p1.x, p0.y), 0.0)) +
	       g1.y * (g0.x * image.SampleLevel(linearClamp, float2(p0.x, p1.y), 0.0) +
		       g1.x * image.SampleLevel(linearClamp, float2(p1.x, p1.y), 0.0));
}

// 線形 -> premultiplied sRGB
float4 PSOut(VertData v) : TARGET
{
	float4 s = (cubic > 0.5) ? hz_bspline(v.uv) : image.SampleLevel(linearClamp, v.uv, 0.0);
	float3 lin = s.rgb / max(s.a, 0.0001);
	return float4(hz_lin_to_srgb(lin) * s.a, s.a);
}

technique Lin
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLin(v);
	}
}

technique DownLin
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDownLin(v);
	}
}

technique Down2
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDown2(v);
	}
}

technique Disc
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDisc(v);
	}
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSOut(v);
	}
}
